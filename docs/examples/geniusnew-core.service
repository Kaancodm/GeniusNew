# NICHT INSTALLIEREN: HOLD bis zur A2/C5-Systemabnahme und zum
# unabhaengigen Security-Review der Namespace-Haertung (PR #140).
# Keine Schutzoption eigenmaechtig entfernen. docs/OPERATIONS-C5-DRAFT.md.
[Unit]
Description=GeniusNew core
After=network.target geniusnew-anchor.service
Requires=geniusnew-anchor.service

[Service]
Type=simple
User=geniusnew
Group=geniusnew
SupplementaryGroups=geniusnew-audit geniusnew-db
WorkingDirectory=/opt/geniusnew
ExecStart=/opt/geniusnew/.venv/bin/python -I -m geniusnew serve --config /etc/geniusnew/geniusnew.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitCORE=0
TasksMax=512
MemoryMax=2G
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
