[Unit]
Description=GeniusNew local development AI
After=network-online.target

[Service]
ExecStart=%h/.local/share/genius-workflow/ollama/0.40.1/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=%h/.local/share/genius-workflow/models
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_CONTEXT_LENGTH=2048
Environment=OLLAMA_KEEP_ALIVE=2m
Environment=OLLAMA_NO_CLOUD=1
Restart=on-failure
RestartSec=5
CPUQuota=400%
MemoryHigh=5G
MemoryMax=6G
NoNewPrivileges=yes

[Install]
WantedBy=default.target
